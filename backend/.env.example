# =============================================================================
# SUPABASE DATABASE CONFIGURATION
# =============================================================================
# Get these values from your Supabase project:
# 1. Go to Settings > Database
# 2. Copy the URI from "Connection string" section

# PostgreSQL connection string for Supabase
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase project URL and keys (from Settings > API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJ...your_anon_key...
SUPABASE_SERVICE_KEY=eyJ...your_service_key...

# =============================================================================
# MARKET CONFIGURATION
# =============================================================================
# Default market to use when not specified
DEFAULT_MARKET_ID=insurance_il

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# CORS (frontend URL)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Claude API (for brand-domain mapping)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_API_KEY_HERE

# Debug mode (set to true for development)
DEBUG=false
